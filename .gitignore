Whisper_Verification_Sessions/
splits/
metadata/

# --- Feature caches & precomputed tensors ---
training_conventional/data_pkl/
training/data_final/

# --- Model checkpoints / weights (keep configs+history+plots, drop binaries) ---
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.pkl
*.npy
*.npz
*.h5
*.onnx
*.tflite

