*.flac
*.mp3
*.m4a
*.ogg
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.docx
*.pdf
*.pyc
__pycache__/

# Local/runtime files
*.log
*.err
*.out
*.pid
*.lock
.cache/
.tmp/

# Local cross-OS transfer bundles (may contain secrets/auth tokens)
_linux_transfer/
skills_transfer_bundle/

# Local/generated Colab upload snapshot; regenerate with
